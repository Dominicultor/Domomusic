<section id="video">
    <h3>Videoclipuri muzicale</h3>





    <section id="video-local">
    <h3>Prezentare video DomoMusic</h3>

    <video class="video-vtt"
           controls
           preload="auto"
           poster="/resurse/imagini/poster-video.jpg">
        <source src="/resurse/video/domomusic.mp4" type="video/mp4">
        <source src="/resurse/video/domomusic.webm" type="video/webm">

        <track src="/resurse/vtt/subtitrari-ro.vtt"
               kind="subtitles"
               srclang="ro"
               label="Română"
