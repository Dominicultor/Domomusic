<header id="top">
<hgroup>
    <h1>
        DomoMusic - Magazin muzical
        <i class="fa-solid fa-guitar"></i>
    </h1>
    <p>Instrumente muzicale, albume și viniluri pentru pasionații de muzică</p>
</hgroup>

<nav id="meniul-principal">
    <label id="label-burger" for="ch-menu">
        <div class="burger-icon">
            <span></span>
            <span></span>
            <span></span>
        </div>
    </label>

    <input type="checkbox" id="ch-menu">

    <ul class="meniu">
        <li>
            <a href="/">
                <span class="icon"><i class="fa-solid fa-house"></i></span>
                <span class="text">Acasă</span>
            </a>
            <ul>
                <li><a href="/despre">Despre site</a></li>
                <li><a href="/#despre">Despre DomoMusic</a></li>
                <li><a href="/#instrumente">Instrumente muzicale</a></li>
                <li><a href="/#albume">Albume și viniluri</a></li>
                <li><a href="/#video">Videoclipuri</a></li>
            </ul>
        </li>

       <li>
    <a href="/produse">
        <span class="icon"><i class="fa-solid fa-compact-disc"></i></span>
        <span class="text">Produse</span>
    </a>

    <ul>
        <li><a href="/produse">Toate</a></li>

        <% if (typeof categorii !== "undefined") { %>
            <% for (let categ of categorii) { %>
                <li>
                    <a href="/produse?categorie=<%= categ.categorie %>">
    <%= categ.categorie %>
</a>
                    </a>
                </li>
            <% } %>
        <% } %>
    </ul>
</li>

<li>
    <a href="/oferte">
        <span class="icon"><i class="fa-solid fa-tags"></i></span>
        <span class="text">Oferte</span>
    </a>
</li>

        <li>
            <a href="#">
                <span class="icon"><i class="fa-solid fa-images"></i></span>
                <span class="text">Galerii</span>
            </a>
            <ul>
                <li><a href="/galerie-statica">Galerie statică</a></li>
                <li><a href="/galerie-animata">Galerie dinamică</a></li>
            </ul>
        </li>

        <li>
            <a href="/contact">
                <span class="icon"><i class="fa-solid fa-envelope"></i></span>
                <span class="text">Contact</span>
            </a>
        </li>
    </ul>
</nav>



<div id="container-tema">

    <label for="select-tema">
        <i class="fa-solid fa-palette"></i>
    </label>

    <select id="select-tema">
        <option value="light">Light</option>
        <option value="dark">Dark</option>
        <option value="neon">Neon</option>
    </select>

</div>

</header>