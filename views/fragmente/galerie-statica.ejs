<section id="galerie-statica">
    <h2>Galerie statică</h2>

    <div class="grid-galerie">

        <% galerie.imagini.forEach(function(img, index) { %>

            <figure>
                <picture>

                    <source
                        media="(max-width: 700px)"
                        srcset="<%= galerie.cale_galerie %>/mici/<%= img.cale_imagine %>">

                    <source
                        media="(max-width: 1200px)"
                        srcset="<%= galerie.cale_galerie %>/medii/<%= img.cale_imagine %>">

                    <img
                        src="<%= galerie.cale_galerie %>/mari/<%= img.cale_imagine %>"
                        alt="<%= img.alt || img.cale_imagine %>"
                        title="<%= img.descriere %>">
                </picture>

                <figcaption>
                    <%= img.titlu %> - <%= img.descriere %>
                </figcaption>

            </figure>

        <% }) %>

    </div>
</section>